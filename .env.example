# Environment & Security
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web

# Note: The backend also supports DJANGO_ prefixed aliases:
# DJANGO_SECRET_KEY, DJANGO_DEBUG, DJANGO_ALLOWED_HOSTS, DJANGO_ENV

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Kolkata

# Initial Superuser Provisioning (Render / Automated Deployment)
DJANGO_SUPERUSER_EMAIL=admin@digitalbill.local
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_FIRST_NAME=Admin

# Database (PostgreSQL for staging/production; SQLite fallback for dev if unset)
DATABASE_URL=postgres://digitalbill_user:digitalbill_password@db:5432/digitalbill_db

# Redis & Celery
# Set CELERY_TASK_ALWAYS_EAGER=True to run tasks synchronously without requiring a Celery worker on Render free tier
CELERY_TASK_ALWAYS_EAGER=False
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AWS S3 / Cloudflare R2 (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# WhatsApp Cloud API (Optional - required for live WhatsApp messaging)
# Supports canonical WHATSAPP_ACCESS_TOKEN and legacy WHATSAPP_API_TOKEN
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0

# Email
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com

# SMS
SMS_PROVIDER_API_KEY=

# Sentry
SENTRY_DSN=

# AI Provider
AI_PROVIDER_API_KEY=

# Frontend
# For production behind Nginx reverse proxy, defaults to /api/v1 (same-origin).
# For standalone local frontend dev against port 8000 backend, set to http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=/api/v1
